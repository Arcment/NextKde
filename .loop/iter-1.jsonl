erObject\", command.target, command.kind, JSON.stringify(point))\n                        if (point.found) pointerDriver.pointer(reviewWindow, point.x, point.y, command.kind)\n                        return\n                    }\n                    if (command.action === \"scrollInfo\") {\n                        console.info(\"[UIReview] scrollInfo\", pointerDriver.scrollInfo(reviewWindow))\n                        return\n                    }\n                    if (command.action === \"runtimeInfo\") {\n                        console.info(\"[UIReview] runtime\", JSON.stringify({\n                            width: reviewWindow.width, height: reviewWindow.height,\n                            dpr: reviewWindow.Screen.devicePixelRatio,\n                            appearance: AppTheme.appearanceMode, dark: AppTheme.dark,\n                            fontFamily: reviewWindow.font.family,\n                            fontPixelSize: reviewWindow.font.pixelSize\n                        }))\n                        return\n                    }\n                    if (command.action === \"inspectGeometry\") {\n                        const result = []\n                        for (let n = 0; n < command.names.length; ++n) {\n                            const item = reviewWindow.objectNamed(reviewWindow.contentItem, command.names[n])\n                            if (!item) {\n                                result.push({name: command.names[n], available: false})\n                                continue\n                            }\n                            const point = item.mapToItem(reviewWindow.contentItem, 0, 0)\n                            result.push({name: command.names[n], width: item.width, height: item.height,\n                                         x: point.x, y: point.y, visible: item.visible})\n                        }\n                        console.info(\"[UIReview] geometry\", JSON.stringify(result))\n                        return\n                    }\n                    if (command.action === \"regionWheel\" || command.action === \"regionPosition\") {\n                        const region = reviewWindow.objectNamed(reviewWindow.contentItem, command.viewport)\n                        if (!region) {\n                            console.info(\"[UIReview] region unavailable\", command.viewport)\n                            return\n                        }\n                        const scroll = typeof region.flick === \"function\" ? region : region.contentItem\n                        console.info(\"[UIReview] region\", command.viewport, \"contentY\", scroll.contentY,\n                                     \"height\", scroll.height, \"contentHeight\", scroll.contentHeight)\n                        if (command.action === \"regionWheel\") {\n                            const point = region.mapToItem(reviewWindow.contentItem, region.width / 2, region.height / 2)\n                            pointerDriver.wheel(reviewWindow, point.x, point.y, command.angleY)\n                        } else {\n                            scroll.cancelFlick()\n                            scroll.contentY = command.contentY\n                        }\n                        return\n                    }\n                    if (command.action === \"pointer\") {\n                        const control = command.target\n                            ? (reviewWindow.objectNamed(reviewWindow.contentItem, command.target)\n                               || reviewWindow.controlNamed(reviewWindow.contentItem, command.target)) : null\n                        const point = control\n                            ? control.mapToItem(reviewWindow.contentItem, control.width / 2, control.height / 2)\n                            : Qt.point(Number(command.x), Number(command.y))\n                        pointerDriver.pointer(reviewWindow, point.x, point.y, command.kind)\n                        console.info(\"[UIReview] pointer\", command.kind, command.target,\n                                     point.x, point.y, \"hover\", control ? control.hovered : \"n/a\",\n                                     \"down\", control ? control.down : \"n/a\")\n                        return\n                    }\n                    if (command.action === \"typeText\") {\n                        pointerDriver.typeText(reviewWindow, command.text)\n                        const input = objectNamed(reviewWindow.contentItem, \"toolbarSearchInput\")\n                        console.info(\"[UIReview] textInput\", input ? input.text : \"missing\",\n                                     \"focus\", input ? input.activeFocus : false)\n                        return\n                    }\n                    if (command.action === \"escape\") {\n                        pointerDriver.escape(reviewWindow)\n                        return\n                    }\n                    if (command.action === \"resize\") {\n                        reviewWindow.width = command.width\n                        reviewWindow.height = command.height\n                        return\n                    }\n                    if (command.action === \"sidebar\") {\n                        reviewWindow.sidebarExpanded = command.expanded\n                        return\n                    }\n                    if (command.action === \"view\") {\n                        reviewWindow.viewIndex = [\"month\", \"week\", \"day\"].indexOf(command.view)\n                        return\n                    }\n                    if (command.action === \"date\") {\n                        reviewWindow.handleActivation([\"--date\", command.date], \"\")\n                        return\n                    }\n                    if (command.action === \"openItem\") {\n                        const entries = reviewWindow.selectedItems || []\n                        for (let n = 0; n < entries.length; ++n) {\n                            if ((!command.kind || entries[n].kind === command.kind)\n                                    && (!command.titleContains || reviewWindow.itemTitle(entries[n]).indexOf(command.titleContains) >= 0)) {\n                                reviewWindow.openItem(entries[n])\n                                break\n                            }\n                        }\n                        return\n                    }\n                    if (command.action === \"inspect\") {\n                        reviewWindow.inspectLenses(reviewWindow.contentItem)\n                        return\n                    }\n                    const viewport = reviewWindow.scheduleViewport\n                    const timeline = viewport && viewport.contentItem\n                            && typeof viewport.contentItem.flick === \"function\"\n                        ? viewport.contentItem\n                        : reviewWindow.timelineIn(reviewWindow.contentItem)\n                    if (!timeline) {\n                        console.info(\"[UIReview] No visible timeline for manual command\")\n                        return\n                    }\n                    console.info(\"[UIReview] manual\", command.action,\n                                 \"contentY\", timeline.contentY,\n                                 \"width\", timeline.width, \"height\", timeline.height,\n                                 \"contentHeight\", timeline.contentHeight)\n                    if (command.action === \"wheel\") {\n                        const point = timeline.mapToItem(reviewWindow.contentItem,\n                                                         timeline.width / 2, timeline.height / 2)\n                        pointerDriver.wheel(reviewWindow, point.x, point.y, command.angleY)\n                    } else if (command.action === \"flick\") {\n                        if (command.cancelFirst)\n                            timeline.cancelFlick()\n                        timeline.flick(0, command.velocity)\n                    